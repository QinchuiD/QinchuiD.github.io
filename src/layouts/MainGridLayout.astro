---
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import SearchDialog from "../components/SearchDialog.astro";
import { siteConfig } from "../config";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;
const tocHeadings = siteConfig.toc.enable
	? headings.filter(
			(heading) =>
				heading.depth > 1 && heading.depth <= siteConfig.toc.depth + 1,
		)
	: [];
---
<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>
    <slot slot="head" name="head" />
    <Navbar />
    <main id="main-content" class:list={["site-main", { "has-toc": tocHeadings.length > 0 }]}>
        <div class="reading-layout">
            {tocHeadings.length > 0 && (
                <aside class="reading-toc" id="toc" aria-label="文章目录">
                    <div class="toc-sticky">
                        <p class="toc-caption">目录</p>
                        <nav>
                            {tocHeadings.map(heading => (
                                <a href={`#${heading.slug}`} class:list={{ "toc-subheading": heading.depth > 2 }}>
                                    {heading.text.replace(/\s*#$/, "")}
                                </a>
                            ))}
                        </nav>
                    </div>
                </aside>
            )}
            <div id="content-wrapper" class="reading-content">
                <slot />
            </div>
        </div>
    </main>
    <Footer />
    <SearchDialog />
    <button class="back-to-top header-icon bordered-icon" data-back-to-top type="button" hidden aria-label="返回顶部">
        <Icon name="material-symbols:arrow-upward-rounded" />
    </button>
</Layout>
