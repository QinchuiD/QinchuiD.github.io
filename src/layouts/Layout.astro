---
import "../styles/variables.styl";
import "../styles/global.css";
import "../styles/markdown-extend.styl";
import "@fontsource-variable/jetbrains-mono";
import "katex/dist/katex.css";
import "photoswipe/style.css";

import { profileConfig, siteConfig } from "../config";
import { DEFAULT_THEME } from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import { url } from "../utils/url-utils";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

const { title, description, lang, setOGTypeArticle = false } = Astro.props;
const pageTitle = title
	? `${title} - ${siteConfig.title}`
	: `${siteConfig.title} - ${siteConfig.subtitle}`;
const pageDescription = description || profileConfig.bio || pageTitle;
const siteLang = (lang || siteConfig.lang).replace("_", "-");
const favicons = siteConfig.favicon.length
	? siteConfig.favicon
	: defaultFavicons;
const configHue = siteConfig.themeColor.hue;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
---
<!doctype html>
<html lang={siteLang} data-theme-mode={DEFAULT_THEME}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        <meta name="author" content={profileConfig.name} />
        <link rel="canonical" href={canonical} />
        <meta property="og:site_name" content={siteConfig.title} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content={setOGTypeArticle ? "article" : "website"} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        {favicons.map(favicon => (
            <link rel="icon" href={favicon.src.startsWith("/") ? url(favicon.src) : favicon.src}
                sizes={favicon.sizes}
                media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`} />
        ))}
        <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={url("/rss.xml")} />
        <script is:inline define:vars={{ DEFAULT_THEME, configHue }}>
            let theme = DEFAULT_THEME;
            let hue = configHue;
            try {
                const storedTheme = localStorage.getItem("theme");
                if (["light", "dark", "auto"].includes(storedTheme)) theme = storedTheme;
                const storedHue = Number(localStorage.getItem("hue"));
                if (localStorage.getItem("hue") !== null && Number.isFinite(storedHue)) hue = storedHue;
            } catch {}
            document.documentElement.dataset.themeMode = theme;
            document.documentElement.classList.toggle("dark",
                theme === "dark" || (theme === "auto" && matchMedia("(prefers-color-scheme: dark)").matches));
            document.documentElement.style.setProperty("--hue", String(hue));
        </script>
        <slot name="head" />
    </head>
    <body>
        <a class="skip-link" href="#main-content">跳转至正文</a>
        <slot />
    </body>
</html>

<script>
import PhotoSwipeLightbox from "photoswipe/lightbox";

const preference = window.matchMedia("(prefers-color-scheme: dark)");

function applyTheme(mode: string) {
	const root = document.documentElement;
	root.dataset.themeMode = mode;
	root.classList.toggle(
		"dark",
		mode === "dark" || (mode === "auto" && preference.matches),
	);
	for (const button of document.querySelectorAll<HTMLButtonElement>(
		"[data-theme-choice]",
	)) {
		button.setAttribute("aria-pressed", String(button.dataset.themeChoice === mode));
	}
}

applyTheme(document.documentElement.dataset.themeMode || "auto");

preference.addEventListener("change", () => {
	if (document.documentElement.dataset.themeMode === "auto") applyTheme("auto");
});

document.addEventListener("click", (event) => {
	const target = event.target;
	if (!(target instanceof Element)) return;
	const choice = target.closest<HTMLButtonElement>("[data-theme-choice]");
	if (choice?.dataset.themeChoice) {
		applyTheme(choice.dataset.themeChoice);
		try {
			localStorage.setItem("theme", choice.dataset.themeChoice);
		} catch {}
		choice.closest("details")?.removeAttribute("open");
	}
	for (const details of document.querySelectorAll<HTMLDetailsElement>(
		".header-popover[open]",
	)) {
		if (!details.contains(target)) details.open = false;
	}
	if (target.closest("[data-back-to-top]")) window.scrollTo({ top: 0, behavior: "smooth" });
});

document.addEventListener("keydown", (event) => {
	if (event.key !== "Escape") return;
	for (const details of document.querySelectorAll<HTMLDetailsElement>(
		".header-popover[open]",
	)) {
		details.open = false;
		details.querySelector("summary")?.focus();
	}
});

window.addEventListener("storage", (event) => {
	if (event.key === "theme") applyTheme(event.newValue || "auto");
});

const backToTop = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
function updateBackToTop() {
	if (backToTop) backToTop.hidden = window.scrollY < 400;
}
window.addEventListener("scroll", updateBackToTop, { passive: true });
updateBackToTop();

const lightbox = new PhotoSwipeLightbox({
	gallery: ".custom-md img, #post-cover img",
	pswpModule: () => import("photoswipe"),
	padding: { top: 24, bottom: 24, left: 24, right: 24 },
	wheelToZoom: true,
	arrowPrev: false,
	arrowNext: false,
	imageClickAction: "close",
	tapAction: "close",
	doubleTapAction: "zoom",
});
lightbox.addFilter("domItemData", (item, element) => {
	if (element instanceof HTMLImageElement) {
		item.src = element.currentSrc || element.src;
		item.msrc = item.src;
		item.w = element.naturalWidth || window.innerWidth;
		item.h = element.naturalHeight || window.innerHeight;
	}
	return item;
});
lightbox.init();
</script>
