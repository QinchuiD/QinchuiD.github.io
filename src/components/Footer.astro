---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
const github = profileConfig.links.find((link) =>
	link.url.startsWith("https://github.com/"),
);
---
<footer class="site-shell site-footer">
    <div class="footer-copy">
        <span>&copy; {currentYear} {profileConfig.name}</span>
        <span class="footer-credit">
            <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>
            <span aria-hidden="true"> · </span>
            设计参考 <a href="https://axi404.top/" target="_blank" rel="noopener noreferrer">Astro-Axi</a>
        </span>
    </div>
    <div class="footer-links">
        {github && <a href={github.url} aria-label="GitHub" target="_blank" rel="noopener noreferrer">
            <Icon name="fa6-brands:github" />
        </a>}
        <a href={url("/rss.xml")} aria-label="RSS 订阅"><Icon name="material-symbols:rss-feed-rounded" /></a>
    </div>
</footer>
